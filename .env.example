# Resend API key (starts with re_). RESEND_API_KEY or SMTP_PASS works.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Contact From Site <site@mail.f5sites.com>"
EMAIL_TO=site@mail.f5sites.com

# Local development only (Angular dev server proxies /api to :3000).
# In production (Docker / nginx-proxy) do NOT set PORT so the app listens on 80.
PORT=3000
